{
  "guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../scripts/hooks/guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "stop-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "python3 ../scripts/hooks/stop_gate.py",
        "timeout": 20
      }
    ]
  }
}
