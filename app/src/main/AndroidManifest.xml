<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- REQ-001, NFR-001: Only SYSTEM_ALERT_WINDOW is requested -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.QuickStopWatch">

        <!-- SCR-001: Launcher activity showing usage instructions -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- DD-008: Overlay service without FGS (ADR-0002) -->
        <service
            android:name=".service.StopwatchOverlayService"
            android:exported="false" />

        <!-- DD-007, REQ-018: Quick Settings Tile -->
        <service
            android:name=".service.QuickStopWatchTileService"
            android:exported="true"
            android:label="@string/tile_name"
            android:icon="@drawable/ic_qs_stopwatch"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
